# PostgreSQL — these must match the values in DATABASE_URL below
POSTGRES_DB=waai
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Full connection string used by Prisma
DATABASE_URL="postgresql://user:password@postgres:5432/waai"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Grok AI API key — get yours from https://console.x.ai
GROK_API_KEY=xai-your-key-here

# App port
PORT=3000
